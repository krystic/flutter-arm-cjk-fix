#!/bin/bash

# --- 路径定义 ---
CONFIG_DIR="${FLUTTER_CJK_CONFIG_DIR:-/etc/flutter-cjk}"
CONFIG_FILE="$CONFIG_DIR/ubuntu.conf"
NON_SNAP_CONFIG_DIR="$CONFIG_DIR/executables"
SERVICE_FILE="${FLUTTER_CJK_SERVICE_FILE:-/etc/systemd/system/flutter-font-fix.service}"
COMPLETION_FILE="${FLUTTER_CJK_COMPLETION_FILE:-/etc/bash_completion.d/flutter-font-fix}"
SCRIPT_PATH=$(realpath "${BASH_SOURCE[0]}")
INSTALL_PATHS_FILE="${SCRIPT_PATH}.paths"

# 自定义字体配置目录（与全局配置统一目录）
CUSTOM_FONT_CONFIG_DIR="$CONFIG_DIR"

# SO 文件版本检测和目录
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
DEFAULT_INSTALLED_MODULE_DIR="/usr/local/lib/flutter-font-fix"
DEFAULT_SO_LIB_DIR="/usr/local/lib/flutter-cjk"
CONFIGURED_MODULE_DIR=""
CONFIGURED_SO_LIB_DIR=""
CONFIGURED_REPO_REF=""
if [[ -r "$INSTALL_PATHS_FILE" ]]; then
    while IFS='=' read -r path_key path_value; do
        case "$path_key" in
            module_dir) CONFIGURED_MODULE_DIR="$path_value" ;;
            so_lib_dir) CONFIGURED_SO_LIB_DIR="$path_value" ;;
            repo_ref) CONFIGURED_REPO_REF="$path_value" ;;
        esac
    done < "$INSTALL_PATHS_FILE"
fi
INSTALLED_MODULE_DIR="${CONFIGURED_MODULE_DIR:-$DEFAULT_INSTALLED_MODULE_DIR}"
SO_LIB_DIR="${FLUTTER_CJK_SO_LIB_DIR:-${CONFIGURED_SO_LIB_DIR:-$DEFAULT_SO_LIB_DIR}}"
FLUTTER_HASH_VERSION_CACHE="$CONFIG_DIR/flutter.engine.hash.version"
SNAP_ROOT="${FLUTTER_CJK_SNAP_ROOT:-/snap}"

# GitHub Raw CDN 前缀（可通过 --cdn 参数覆盖）
RAW_CDN_PREFIX="https://raw.githubusercontent.com/"
REPO_REF="${FLUTTER_CJK_REPO_REF:-${CONFIGURED_REPO_REF:-main}}"
GITHUB_RAW_BASE="${FLUTTER_CJK_REPO_RAW:-${RAW_CDN_PREFIX}krystic/flutter-arm-cjk-fix/$REPO_REF}"
GITHUB_RAW_LIB="${GITHUB_RAW_BASE}/lib"

NOTO_DIR="${FLUTTER_CJK_NOTO_DIR:-/usr/share/fonts/opentype/noto}"
NOTO_REG="$NOTO_DIR/NotoSansCJK-Regular.ttc"
NOTO_BOLD="$NOTO_DIR/NotoSansCJK-Bold.ttc"
NOTO_LIGHT="$NOTO_DIR/NotoSansCJK-Light.ttc"
NOTO_MEDIUM="$NOTO_DIR/NotoSansCJK-Medium.ttc"


# --- 模块加载 ---
MODULE_DIR="${FLUTTER_CJK_MODULE_DIR:-}"
if [[ -z "$MODULE_DIR" ]]; then
    if [[ -d "$SCRIPT_DIR/src" ]]; then
        MODULE_DIR="$SCRIPT_DIR/src"
    else
        MODULE_DIR="$INSTALLED_MODULE_DIR"
    fi
fi

for module in engine non-snap snap system cli; do
    module_file="$MODULE_DIR/$module.sh"
    if [[ ! -r "$module_file" ]]; then
        echo "[ERROR] Required module not found: $module_file" >&2
        echo "        缺少必要模块，请重新安装 flutter-font-fix。" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$module_file"
done

unset module module_file path_key path_value

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
